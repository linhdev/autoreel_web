/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# `*.mp4` and not `*`: a route slug under `/demo/` would otherwise have its
# HTML cached for a week, and header rules merge rather than override, so the
# `must-revalidate` below would not save it.
/demo/*.mp4
  Cache-Control: public, max-age=604800

# There was a `/docs-img/*` rule here with a short `max-age`, to stop a re-taken
# screenshot being invisible for a year. It did not work, and it made things
# worse: rules merge rather than override, and the live response came back
#
#     Cache-Control: public, max-age=31536000, immutable, public, max-age=86400
#
# which is two `max-age` directives on one response — not a valid header, and
# browsers take the first. Measured with `curl -I` against autoreelvn.com on
# 2026-10-13, which is the check the rule's own comment said to make and which
# had not been made before it shipped.
#
# The screenshots do not need a rule any more. Their names carry a content hash
# (`/docs-img/video-ngan-01-screen-vi.9f3a1c2e.webp`, written by
# `scripts/optimise-docs-shots.mjs`, resolved by `scripts/lib/docs-images.mjs`),
# so a re-shot picture is a new address and this rule below is simply true.
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/embed.js
  Cache-Control: public, max-age=3600

# The public download tool. Its CSP is scoped to these two paths rather than
# `/*` because the landing page still uses inline styles and inline scripts
# that a strict policy would break. Turnstile needs both its script and its
# iframe allowed; the Google Fonts entries are what `headAssets` copies from
# the landing page.
/downloads/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob: https://challenges.cloudflare.com; media-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate

/en/downloads/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob: https://challenges.cloudflare.com; media-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate
