{
  "name": "autoreel-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AutoReel landing page - AI Content Automation",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-routes.mjs && node scripts/build-posts.mjs && node scripts/build-docs.mjs && node scripts/build-downloads.mjs && node scripts/build-download-platforms.mjs && node scripts/build-download-tools.mjs && node scripts/build-download-use-cases.mjs && node scripts/build-reference-page.mjs",
    "build:posts": "node scripts/build-posts.mjs",
    "preview": "vite preview",
    "assets": "node scripts/generate-assets.mjs",
    "smoke": "vite build --ssr scripts/ssr-smoke.jsx --outDir .ssr-tmp --logLevel error && node .ssr-tmp/ssr-smoke.js",
    "verify": "node scripts/verify-build.mjs",
    "test": "node --test tests/downloads-urls.test.mjs tests/push.test.mjs",
    "docs:shots": "node scripts/optimise-docs-shots.mjs",
    "check:posts": "node scripts/check-posts.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}
